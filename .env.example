# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore, so your real keys never reach GitHub.
# Never share these values in chat, screenshots or code.

# NewsAPI.org -> Account -> API key
NEWSAPI_KEY=

# Supabase -> Project Settings -> Data API -> Project URL
# looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# (or the legacy "service_role" key). It can write to the database:
# server-side only, never in the website code.
SUPABASE_SECRET_KEY=

# Optional: how many days back to search each run (default 3)
# NEWS_LOOKBACK_DAYS=3

# Google AI Studio (aistudio.google.com) -> Get API key
GEMINI_API_KEY=

# Optional: Gemini model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Safe to put in the website: it can only READ (Row Level Security blocks writes).
SUPABASE_PUBLISHABLE_KEY=
